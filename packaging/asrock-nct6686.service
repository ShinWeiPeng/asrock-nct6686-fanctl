[Unit]
Description=ASRock NCT6686 guarded hwmon driver (readonly at boot)
After=systemd-modules-load.service
Before=coolercontrold.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/asrock-nct6686/load-readonly.sh
ExecStop=/usr/local/libexec/asrock-nct6686/stop-driver.sh
TimeoutStartSec=15
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
